# Local development only. Replace authentication secrets before exposing services.
POSTGRES_USER=erp_local
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=construction_erp
DATABASE_URL=postgresql://erp_local:local-only-change-me@localhost:5432/construction_erp?schema=public

REDIS_URL=redis://localhost:6379

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=local-only-access-secret-replace-before-deploy-0123456789
JWT_REFRESH_SECRET=local-only-refresh-secret-replace-before-deploy-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COMPANY_TIMEZONE=Asia/Kolkata

# Local MinIO (private bucket; browser-accessible presigned URLs use port 9000).
MINIO_ROOT_USER=rtinfra_local
MINIO_ROOT_PASSWORD=local-only-minio-password
MEDIA_BUCKET=construction-erp-media
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rtinfra_local
S3_SECRET_ACCESS_KEY=local-only-minio-password
S3_PRESIGNED_URL_TTL_SECONDS=900
MINIO_CORS_ORIGIN=http://localhost:3000

# Optional local-only test login. Keep disabled in production.
DEV_LOGIN_ENABLED=false
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=

# Production Vercel admin login. Set these only in Vercel Environment Variables.
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_PASSWORD=

# Required before running the seed command.
SEED_ADMIN_PASSWORD=ChangeThisLocalSeedPassword!
SEED_ADMIN_EMAIL=admin@rtinfra.local

AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=change-me-internal
YOLO_WEIGHTS_PATH=/models/yolov8n.pt
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
